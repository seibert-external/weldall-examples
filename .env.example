# Public HTTPS origins: no trailing slash. Match Coolify's domain routing.
WELDALL_ISSUER=https://weldall.example.com
CONTRACTS_ORIGIN=https://contracts.weldall.example.com
CRM_ORIGIN=https://crm.weldall.example.com
# Generated by npm run generate-env. Do not rotate on each deployment.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
# One-time /setup token; base64url from 32 random bytes. Rotating it invalidates pending setup.
WELDALL_SETUP_TOKEN=
# Also encrypts the OIDC provider secret created during /setup. Keep stable.
WELDALL_CREDENTIAL_ENCRYPTION_KEY=
DEMO_GROUP_PROVIDER_TOKEN=
WELDALL_SIGNING_KID=
WELDALL_SIGNING_PRIVATE_JWK=
WELDALL_SIGNING_PUBLIC_JWK=
CONTRACTS_SIGNING_KID=
CONTRACTS_SIGNING_PRIVATE_JWK=
CONTRACTS_SIGNING_PUBLIC_JWK=
CRM_SIGNING_KID=
CRM_SIGNING_PRIVATE_JWK=
CRM_SIGNING_PUBLIC_JWK=
